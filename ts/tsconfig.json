{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "../wasm/coacd-wasm.mjs": ["wasm/coacd-wasm.mjs.d.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "allowArbitraryExtensions": true
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts", "wasm/**/*.d.ts", "wasm/**/*.d.mts"],
  "exclude": ["dist", "node_modules"]
}
